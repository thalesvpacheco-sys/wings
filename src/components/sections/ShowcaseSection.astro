---
/**
 * 04 · Produto: demonstração navegável das telas da plataforma.
 * As telas são desenhadas no navegador por scripts/showcase.js a partir de data/showcase-demo.js (dados fictícios).
 */
import Logo from "../brand/Logo.astro";
import Icon from "../ui/Icon.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { showcaseScreens } from "../../data/showcase-screens";

const [initial] = showcaseScreens;
---

<section id="produto" class="sec mist showcase" aria-labelledby="showcase-title">
  <div class="wrap">
    <SectionHeading eyebrow="A plataforma em ação" titleId="showcase-title">
      Explore as telas de planejamento e gestão.
      <Fragment slot="lead">
        Uma demonstração navegável, recriada a partir das telas reais da plataforma. Os dados são fictícios e nenhuma
        ação altera informações.
      </Fragment>
    </SectionHeading>

    <div class="sc-layout" data-reveal style="--d:120ms">
      <div>
        <div class="sc-menu" role="tablist" aria-label="Funcionalidades da demonstração" id="sc-menu">
          {showcaseScreens.map((screen) => (
            <button
              role="tab"
              id={`tab-${screen.id}`}
              aria-controls="app-main"
              aria-selected={screen === initial ? "true" : "false"}
              tabindex={screen === initial ? "0" : "-1"}
              data-screen={screen.id}
            >
              <Icon name={screen.icon} />
              <span class="tb">
                <b>{screen.label}</b>
                <span class="ctx">{screen.context}</span>
              </span>
            </button>
          ))}
        </div>
        <p class="sc-hint">
          <b>Demonstração ilustrativa.</b> Clique nos registros, troque lista e Kanban, filtre por status e mova
          cartões. Tudo acontece só neste navegador.
        </p>
      </div>
      <div>
        <p class="sc-context" id="sc-context"></p>
        <div class="app-frame">
          <div class="app-chrome" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <span class="url">app.wingsbr · Residencial Alameda (exemplo)</span>
            <span class="demo-flag">Demonstração · dados fictícios</span>
          </div>
          <div class="app">
            <div class="app-side" role="group" aria-label="Menu da plataforma (demonstração)">
              <Logo class="lg" />
              <div class="proj">
                <b>Residencial Alameda</b>
                <small>Projeto de exemplo</small>
              </div>
              <span class="grp">Planejamento</span>
              {showcaseScreens.map((screen) => (
                <button type="button" data-screen={screen.id} aria-current={screen === initial ? "page" : undefined}>
                  <Icon name={screen.icon} />
                  {screen.label}
                  {screen.count && <em>{screen.count}</em>}
                </button>
              ))}
              <div class="foot">
                Interface ilustrativa.
                <br />
                Dados fictícios.
              </div>
            </div>
            <div class="app-main" id="app-main" role="tabpanel" tabindex="-1" aria-live="polite">
              <div class="app-top">
                <span class="crumb">
                  Controle de campanha · <b id="crumb-cur">{initial.label}</b>
                </span>
                <span class="sync">
                  <i></i>Dados sincronizados (exemplo)
                </span>
              </div>
              <div class="screen" id="screen">
                <noscript>
                  <p class="empty">A demonstração interativa precisa de JavaScript habilitado.</p>
                </noscript>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <dialog class="rec-modal" id="rec-modal" aria-labelledby="dlg-title">
    <div class="dlg-h">
      <div>
        <h4 id="dlg-title"></h4>
        <small id="dlg-sub"></small>
      </div>
      <button class="dlg-close" type="button" id="dlg-close" aria-label="Fechar detalhes"></button>
    </div>
    <div class="dlg-b" id="dlg-body"></div>
    <div class="dlg-f">
      Registro de demonstração com dados fictícios. Na plataforma, este painel permite atribuir responsáveis e editar o
      registro.
    </div>
  </dialog>
</section>

<script>
  import { initShowcase } from "../../scripts/showcase.js";
  initShowcase();
</script>
