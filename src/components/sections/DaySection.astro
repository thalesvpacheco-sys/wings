---
/** 03 · Um dia na operação: o mesmo horário com e sem a plataforma. */
import { hours } from "../../data/interactive.js";

const labels = [
  { hr: "09h12", lb: "Lead chega" },
  { hr: "11h40", lb: "Verba de mídia" },
  { hr: "14h05", lb: "Aprovação de arte" },
  { hr: "18h30", lb: "Fechamento do dia" },
];
---

<section class="sec" data-switch>
  <div class="wrap">
    <div class="sechead rv">
      <span class="ey">Um dia na operação</span>
      <h2 class="h2">O que muda, hora a hora.</h2>
      <p class="lead">Escolha um horário e veja o mesmo dia de rodada de negócios, com e sem a plataforma.</p>
    </div>
    <div class="tl rv">
      <div class="tlnav" style="--tl:0" data-switch-progress>
        {labels.map((l, i) => (
          <button
            type="button"
            class:list={["tlb", { on: i === 0 }]}
            aria-pressed={i === 0 ? "true" : "false"}
            data-switch-tab={i}
          >
            <span class="dot" />
            <span class="hr">{l.hr}</span>
            <span class="lb">{l.lb}</span>
          </button>
        ))}
      </div>
      {hours.map((h, i) => (
        <div class="tlcard" data-switch-panel={i} hidden={i !== 0}>
          <span class="ey">{h.time}</span>
          <h3>{h.title}</h3>
          <div class="tlsplit">
            <div class="tlbox">
              <span class="tag" style="color:var(--crit)">
                Sem plataforma
              </span>
              <p>{h.before}</p>
            </div>
            <div class="tlbox" style="background:#F0F6FF;border-color:#C6D9F2">
              <span class="tag" style="color:var(--royal-hi)">
                Com WingsBr
              </span>
              <p>{h.after}</p>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:11px;padding-top:4px">
            <span style="width:34px;height:34px;flex:none;border-radius:9px;background:var(--mist);display:grid;place-items:center;color:var(--royal-hi)">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M9 12l2 2 4-4M20 12a8 8 0 11-16 0 8 8 0 0116 0z" />
              </svg>
            </span>
            <span style="font-size:13px;color:var(--slate)">
              <b style="font-weight:500">Registro gerado:</b> {h.rec}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
