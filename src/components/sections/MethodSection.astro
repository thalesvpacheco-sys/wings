---
/** 06 · Método: os cinco pilares do MICCA. */
import Bands from "../brand/Bands.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { miccaPillars } from "../../data/content";
---

<section id="micca" class="sec dark micca" aria-labelledby="micca-title">
  <Bands />
  <div class="wrap">
    <SectionHeading eyebrow="Inteligência que orienta resultados" titleId="micca-title">
      Não desenvolvemos apenas um software.
      <br />
      <span class="accent">Incorporamos uma metodologia de performance.</span>
      <Fragment slot="lead">
        A WingsBr foi concebida com base no método MICCA, desenvolvido por Bruno Dourado, sócio-fundador da Grifo
        Agency, a partir da experiência prática em marketing, gestão e lançamentos imobiliários.
      </Fragment>
    </SectionHeading>
    <ol class="pillars">
      {miccaPillars.map((p, i) => (
        <li class="pillar" data-reveal style={i ? `--d:${i * 80}ms` : undefined}>
          <span class="L" aria-hidden="true">
            {p.letter}
          </span>
          <b>{p.name}</b>
          <span>{p.text}</span>
        </li>
      ))}
    </ol>
    <div class="micca-foot">
      <p class="lead" data-reveal>
        Validado na experiência de 11 anos da Grifo Agency e aprofundado na pesquisa acadêmica de mestrado do autor, o
        MICCA é a base conceitual da inteligência estratégica da WingsBr.
      </p>
      <a class="link-arrow" href="#produto" data-screen="planejador" data-reveal>
        Planejador MICCA na demonstração <i aria-hidden="true"></i>
      </a>
    </div>
    <blockquote class="quote" data-reveal>
      <p>Tecnologia com método. Gestão com propósito. Performance com inteligência.</p>
    </blockquote>
  </div>
</section>
