---
import { icons, type IconName } from "./icons";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  set:html={icons[name]}
/>
