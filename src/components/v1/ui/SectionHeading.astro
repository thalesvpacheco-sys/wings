---
/**
 * Cabeçalho padrão de seção: rótulo, título (com destaque opcional na segunda linha) e texto de apoio.
 * O título vai no slot padrão; o texto de apoio, no slot "lead".
 */
interface Props {
  eyebrow: string;
  /** id do <h2>, referenciado pelo aria-labelledby da seção. */
  titleId: string;
}

const { eyebrow, titleId } = Astro.props;
const hasLead = Astro.slots.has("lead");
---

<div class="sec-head">
  <div>
    <div class="eyebrow" data-reveal>
      {eyebrow}
    </div>
    <h2 id={titleId} data-reveal style="--d:80ms">
      <slot />
    </h2>
  </div>
  {hasLead && (
    <p class="lead" data-reveal style="--d:160ms">
      <slot name="lead" />
    </p>
  )}
</div>
