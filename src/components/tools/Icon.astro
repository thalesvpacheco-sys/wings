---
import { toolIcons, type ToolIconName } from "./icons";

interface Props {
  name: ToolIconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 24 24"
  stroke-width="1.6"
  stroke="currentColor"
  width={size}
  height={size}
  aria-hidden="true"
>
  <path stroke-linecap="round" stroke-linejoin="round" d={toolIcons[name]}></path>
</svg>
