---
/** 06 · Para quem é: seletor por segmento. */
import { segments } from "../../../data/v2/interactive.js";

const icons = [
  '<path d="M5 21V7l7-4 7 4v14M9 11h2M13 11h2M10 21v-4h4v4"/>',
  '<path d="M3 20h18M4 20V9l8-5 8 5v11M4 13h16"/>',
  '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M17 11l2 2 4-4"/>',
];
const check = '<path d="M5 13l4 4L19 7"/>';
---

<section class="sec mist" id="publico" data-switch>
  <div class="wrap">
    <div class="sechead c rv">
      <span class="ey">Para quem é</span>
      <h2 class="h2">
        Uma plataforma que <span style="color:var(--royal)">entende o seu mercado.</span>
      </h2>
    </div>
    <div class="rv">
      <div class="segs c">
        {segments.map((s, i) => (
          <button
            type="button"
            class:list={["seg", { on: i === 0 }]}
            aria-pressed={i === 0 ? "true" : "false"}
            data-switch-tab={i}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="square"
              aria-hidden="true"
              set:html={icons[i]}
            />
            {s.tag}
          </button>
        ))}
      </div>
      {segments.map((s, i) => (
        <div class="segpanel" data-switch-panel={i} hidden={i !== 0}>
          <div style="display:flex;flex-direction:column;gap:14px">
            <span class="pill">{s.tag}</span>
            <h3>{s.title}</h3>
            <p class="lead">{s.text}</p>
            <div class="segl">
              {[s.p1, s.p2, s.p3].map((p) => (
                <div>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    aria-hidden="true"
                    set:html={check}
                  />
                  <span>{p}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="segside">
            <div class="segstat">
              <b>{s.s1v}</b>
              <span>{s.s1l}</span>
            </div>
            <div class="segstat">
              <b>{s.s2v}</b>
              <span>{s.s2l}</span>
            </div>
            <a href="#demo" class="btn" style="width:100%;margin-top:auto">
              Ver essa operação na demo
              <svg
                class="ar"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <path d="M3 8h10M9 4l4 4-4 4" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
