---
import "../styles/v1/main.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/v1/layout/SiteHeader.astro";
import SiteFooter from "../components/v1/layout/SiteFooter.astro";
import HeroSection from "../components/v1/sections/HeroSection.astro";
import ProblemSection from "../components/v1/sections/ProblemSection.astro";
import PlatformSection from "../components/v1/sections/PlatformSection.astro";
import ShowcaseSection from "../components/v1/sections/ShowcaseSection.astro";
import AudienceSection from "../components/v1/sections/AudienceSection.astro";
import MethodSection from "../components/v1/sections/MethodSection.astro";
import AboutSection from "../components/v1/sections/AboutSection.astro";
import BenefitsSection from "../components/v1/sections/BenefitsSection.astro";
import CtaSection from "../components/v1/sections/CtaSection.astro";
---

<BaseLayout>
  <SiteHeader />
  <main id="conteudo">
    <HeroSection />
    <ProblemSection />
    <PlatformSection />
    <ShowcaseSection />
    <AudienceSection />
    <MethodSection />
    <AboutSection />
    <BenefitsSection />
    <CtaSection />
  </main>
  <SiteFooter />

  <script>
    import { initReveal } from "../scripts/v1/reveal.js";
    initReveal();
  </script>
</BaseLayout>
