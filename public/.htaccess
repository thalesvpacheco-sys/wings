# WingsBr — configuração para hospedagem Apache/LiteSpeed (Hostinger).
# Vai junto no build (public/ → dist/). Suba o conteúdo de dist/ para public_html/.

Options -Indexes
DirectoryIndex index.html

# o deploy por Git da Hostinger deixa a pasta .git no public_html: nunca servir
RedirectMatch 404 /\.git

# ---------------------------------------------------------------- HTTPS e domínio sem www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------- página de erro
ErrorDocument 404 /404.html

# ---------------------------------------------------------------- compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------- cache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  # arquivos gerados pelo build têm hash no nome: podem ficar em cache para sempre
  <FilesMatch "^_astro/|\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # segurança básica
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
