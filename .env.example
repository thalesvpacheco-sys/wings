# Login do Wings (Firebase Auth). Copie para .env e preencha com os dados do app web do projeto
# no console do Firebase (Configurações do projeto > Seus apps). Sem estas variáveis o login roda
# em modo de teste: entra qualquer e-mail da lista de admins (src/data/team.ts).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
